rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Clarity stores each account's pool data at clarity/{uid}.
    // A signed-in user can read and write ONLY the document whose ID
    // matches their own UID. Nobody can touch anyone else's data,
    // and signed-out requests are denied entirely.
    match /clarity/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is locked shut by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
