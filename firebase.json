{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "old-*.html",
      "*.md",
      "netlify.toml",
      "netlify/**",
      "netlify-old/**",
      "claude.js",
      "firestore.rules",
      "firestore.indexes.json"
    ],
    "rewrites": [
      {
        "source": "/api/claude",
        "function": { "functionId": "claude", "region": "us-central1" }
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [ { "key": "Cache-Control", "value": "no-cache, max-age=0" } ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
